# ==============================
# Django
# ==============================

DEBUG=True

DJANGO_SECRET_KEY=temporary-development-secret-change-this-later

ALLOWED_HOSTS=13.201.18.103,localhost,127.0.0.1


# ==============================
# CORS / CSRF
# ==============================

CORS_ALLOWED_ORIGINS=http://13.201.18.103,http://localhost:5173,http://127.0.0.1:5173

CSRF_TRUSTED_ORIGINS=http://13.201.18.103,http://localhost:5173,http://127.0.0.1:5173


# ==============================
# Database
# ==============================

# False = SQLite
# True = PostgreSQL/RDS

USE_POSTGRES=False

DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=your-rds-password
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_CONN_MAX_AGE=60


# ==============================
# AWS S3 Media Storage
# ==============================

# False for now.
# We will enable this after creating S3.

USE_S3_MEDIA=False

AWS_STORAGE_BUCKET_NAME=your-media-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# Leave empty when using EC2 IAM Role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_QUERYSTRING_AUTH=False


# ==============================
# Security
# ==============================

# Keep False while accessing Django through
# http://13.201.18.103:8000

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False