# Copy to backend/.env for AWS and replace placeholders. Do not commit .env.
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=EC2_PUBLIC_IP,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://YOUR_CLOUDFRONT_OR_S3_FRONTEND_URL
CSRF_TRUSTED_ORIGINS=http://EC2_PUBLIC_IP,https://YOUR_CLOUDFRONT_OR_S3_FRONTEND_URL

# RDS PostgreSQL. With USE_POSTGRES=False (the default), local SQLite is used.
USE_POSTGRES=True
DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=replace-with-rds-password
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional S3 media storage. Prefer an EC2 IAM role; leave the two credential values empty when using one.
USE_S3_MEDIA=True
AWS_STORAGE_BUCKET_NAME=your-media-bucket-name
AWS_S3_REGION_NAME=your-aws-region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=False

# Keep False while using HTTP and an EC2 public IP. Enable after HTTPS is introduced.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
